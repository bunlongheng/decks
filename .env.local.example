# Anthropic Claude API key — used by /api/generate-deck
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-api03-xxx"

# Secret token for the diagrams service at diagrams-bheng.vercel.app
# (used by renderDeck when a section has type: "diagram")
# Generate with: openssl rand -base64 32
AI_API_SECRET="your-secret-token-here"

# Supabase — Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGci..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGci..." # server-only, never expose to client

# Restrict login to just your email (recommended)
ALLOWED_EMAIL="your@email.com"

# Public site URL (used for OAuth redirects in production)
NEXT_PUBLIC_SITE_URL="http://localhost:3010"
