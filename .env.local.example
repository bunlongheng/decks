# Anthropic Claude API key — used by /api/generate-deck
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-api03-xxx"

# Secret token for the diagrams service at diagrams-bheng.vercel.app
# (used by renderDeck when a section has type: "diagram")
# Generate with: openssl rand -base64 32
AI_API_SECRET="your-secret-token-here"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3010"
